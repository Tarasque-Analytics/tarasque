# Frontend (Vite + Supabase Auth)
# Copy this file to .env (project root) and fill in values.
# Note: Vite only exposes variables prefixed with VITE_.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional fallback for older naming:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Model pipeline (optional, only needed for Alpaca data loading)
ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY
