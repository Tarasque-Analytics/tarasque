# Frontend (Vite + Supabase Auth)
# Copy this file to .env (project root) and fill in values.
# Note: Vite only exposes variables prefixed with VITE_.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional fallback for older naming:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY


# Backend Environment Variables
# Copy this file to .env and fill in actual values

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# TODO: PostgreSQL Configuration (uncomment when database is ready)
# DATABASE_URL=postgresql://user:password@localhost:5432/volarbear
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# TODO: Redis Configuration (optional, for caching)
# REDIS_URL=redis://localhost:6379/0

# Environment
DEBUG=True



# Model pipeline (optional, only needed for Alpaca data loading)
ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY