# Frontend (Vite + Supabase Auth)
# Copy this file to .env (project root) and fill in values.
# Note: Vite only exposes variables prefixed with VITE_.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional fallback for older naming:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY


# Backend Environment Variables
# Copy this file to .env and fill in actual values

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# TODO: PostgreSQL Configuration (uncomment when database is ready)
# DATABASE_URL=postgresql://user:password@localhost:5432/volarbear
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# TODO: Redis Configuration (optional, for caching)
# REDIS_URL=redis://localhost:6379/0

# Environment
DEBUG=True



# Model pipeline (optional, only needed for Alpaca data loading)
ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY



# ─────────────────────────────────────────────────────────────────────────────
# Automation pipeline (automation/ — daily data pipeline). See automation/PLAN.md §11.
# The automation pipeline is the only component that WRITES to the DB.
# NEVER commit real values — .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Write-side Supabase (SERVICE-ROLE — bypasses RLS). Distinct from the app's read keys above.
# SUPABASE_URL may reuse the same value as VITE_SUPABASE_URL (the hosted project URL).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY   # SECRET — never expose to the frontend

# Reuses ALPACA_API_KEY / ALPACA_SECRET_KEY above for BOTH stock bars and the options chain.
# Requires an Alpaca plan that includes options (OPRA) market data.

# AI overviews — first provider is Claude (the layer is provider/model-agnostic; see PLAN §8).
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Target environment for the pipeline (dev|stg|prod), mirrors the backend's APP_ENV. Default: dev.
AUTOMATION_ENV=dev


