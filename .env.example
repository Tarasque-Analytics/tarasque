# Frontend (Vite + Supabase Auth)
# Copy this file to .env (project root) and fill in values.
# Note: Vite only exposes variables prefixed with VITE_.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional fallback for older naming:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY


# Backend Environment Variables
# Copy this file to .env and fill in actual values

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Environment
DEBUG=True



# Model pipeline (optional, only needed for Alpaca data loading)
ALPACA_API_KEY=YOUR_ALPACA_API_KEY
ALPACA_SECRET_KEY=YOUR_ALPACA_SECRET_KEY



# ─────────────────────────────────────────────────────────────────────────────
# Automation pipeline (automation/). See automation/CLAUDE.md.
# The automation pipeline is the only component that WRITES to the DB.
# NEVER commit real values — .env is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Write-side Supabase (bypasses RLS). Distinct from the app's read keys above.
# SUPABASE_URL may reuse the same value as VITE_SUPABASE_URL (the hosted project URL).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# New Supabase "secret" API key (sb_secret_...): Dashboard → Project Settings → API keys → create.
# Revocable individually; bypasses RLS. SECRET — never commit or expose to the frontend.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# (Legacy fallback, still accepted if you must: SUPABASE_SERVICE_ROLE_KEY=...)

# Options chain uses yfinance (no API key needed) — see automation/CLAUDE.md §5.

# Target environment (dev|stg|prod), mirrors the backend's APP_ENV. Default: dev.
AUTOMATION_ENV=dev


