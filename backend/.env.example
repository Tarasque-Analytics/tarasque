# Backend Environment Variables
# Copy this file to .env and fill in actual values

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# TODO: PostgreSQL Configuration (uncomment when database is ready)
# DATABASE_URL=postgresql://user:password@localhost:5432/volarbear
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# Supabase Configuration
# URL is public-safe; SUPABASE_ANON_KEY is the RLS-bound anon key for frontend reads.
# Model-side writes use SUPABASE_SERVICE_ROLE_KEY which lives in model/.env only —
# never in backend or frontend env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# TODO: Redis Configuration (optional, for caching)
# REDIS_URL=redis://localhost:6379/0

# Environment
DEBUG=True
