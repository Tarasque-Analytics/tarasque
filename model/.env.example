# Copy this file to model/.env and fill in your values.
# model/.env is gitignored — never commit the real file.

# Alpaca (paper or live trading account — https://alpaca.markets)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Parquet cache root — change to any local path with enough disk space
TARASQUE_BASE_DIR=D:/Tarasque_DB

# WRDS (Wharton Research Data Services — https://wrds-www.wharton.upenn.edu)
WRDS_USERNAME=your_wrds_username
WRDS_PASSWORD=your_wrds_password

# FRED API — free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Enables: macro_hy_spread, macro_breakeven_5y, macro_dollar_ret, macro_inflation_fwd_5y5y
# Also install: pip install fredapi
FRED_API_KEY=your_fred_api_key_here
